# Environment Configuration Example
# Copy this file to .env.local and fill in real values
# DO NOT commit real secrets to git!

# Microsoft Entra ID — Multi-tenant OIDC App Registration
#
# App registration setup (portal.azure.com > Entra ID > App registrations > New registration):
#   Name:                   privaseeAI  (or your preferred name)
#   Supported account types: "Accounts in any organizational directory
#                             (Any Microsoft Entra ID tenant) and personal Microsoft accounts"
#   Redirect URI platform:  Single-page application (SPA)
#   Redirect URI:           http://localhost:5173
#                           (also add your production URL, e.g. https://privaseeai.net)
#
# After creation:
#   - Copy the Application (client) ID  →  VITE_ENTRA_CLIENT_ID
#   - Under Authentication, ensure "Access tokens" and "ID tokens" are enabled
#   - Under API permissions, add delegated: openid, profile, email, User.Read (Microsoft Graph)
#
VITE_ENTRA_CLIENT_ID=__set_at_runtime__
# Optional: override the redirect URI (defaults to window.location.origin)
# VITE_ENTRA_REDIRECT_URI=http://localhost:5173

# Stripe Configuration
# Get these from Stripe Dashboard (https://dashboard.stripe.com/)
# 1. Create a Stripe account
# 2. Go to Developers > API keys
# 3. Copy your secret key (starts with sk_)
# 4. Create webhook endpoint pointing to: http://localhost:3000/api/stripe/webhook
STRIPE_PUBLISHABLE_KEY=__set_at_runtime__
STRIPE_SECRET_KEY=__set_at_runtime__
STRIPE_WEBHOOK_SECRET=__set_at_runtime__

# Stripe Price IDs (create these in Stripe Dashboard > Products)
# Pro Plan - $9.99/month
STRIPE_PRO_PRICE_ID=__set_at_runtime__
# Enterprise Plan - $29.99/month  
STRIPE_ENTERPRISE_PRICE_ID=__set_at_runtime__

# Database
DATABASE_URL=__set_at_runtime__

# Azure Configuration (Production only)
AZURE_STORAGE_ACCOUNT=__set_at_runtime__
AZURE_STORAGE_CONTAINER=__set_at_runtime__
AZURE_QUEUE_NAME=__set_at_runtime__

# Autel EVO Lite Drone Configuration
# Connection Settings
DRONE_HOST=localhost
DRONE_PORT=8889
DRONE_PROTOCOL=tcp
DRONE_API_KEY=__set_at_runtime__

# Flight Settings
DRONE_MAX_SPEED=15
DRONE_MAX_ALTITUDE=120
DRONE_MAX_DISTANCE=500
DRONE_RTH_ALTITUDE=30

# Logging
DRONE_LOG_DIR=./logs/drone

# Drone MVP (Prompt 28)
DRONE_SSID=EVO-LITE-DEV
DRONE_PASSWORD=changeme
MVP_PORT=4001

# AGM Taipan V2 thermal camera (RTSP → HLS proxy)
# Connect your Mac WiFi to the AGM hotspot, then the camera is typically at:
#   rtsp://192.168.10.1:554/stream   (most common)
#   rtsp://192.168.10.1:554/live
# Leave blank to use the Auto-detect button in the UI instead.
RTSP_THERMAL_URL=
